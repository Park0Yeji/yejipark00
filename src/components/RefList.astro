---
// Shared reference list for Publications and Awards.
// Linked rows open the DOI/project externally (square ↗ button); hover lays a
// translucent orange film over the row. Link-less rows reveal "(TBA)" on hover.
interface RefItem {
  code?: string;
  title: string;
  authors?: string;
  venue: string;
  note?: string;
  award?: string | string[]; // one or more highlights, each shown as an orange ★ chip
  link?: string;
}
interface Props {
  items: RefItem[];
}
const { items } = Astro.props;
const nameHl = (authors: string) =>
  authors.replace("Yeji Park", '<span class="me">Yeji Park</span>');
---

<ol class="ref-list">
  {
    items.map((p) => {
      const Tag = p.link ? "a" : "div";
      return (
        <li>
          <Tag
            class="ref-item"
            href={p.link}
            target={p.link ? "_blank" : undefined}
            rel={p.link ? "noopener" : undefined}
          >
            {p.code && <span class="ref-code">[{p.code}]</span>}
            <div class="ref-body">
              <h3 class="ref-title">{p.title}</h3>
              {p.authors && <p class="ref-authors" set:html={nameHl(p.authors)} />}
              <p class="ref-venue">
                <span>
                  {p.venue}
                  {p.note && <span class="ref-note"> · {p.note}</span>}
                  {p.award &&
                    (Array.isArray(p.award) ? p.award : [p.award]).map((a) => (
                      <span class="ref-award">★ {a}</span>
                    ))}
                </span>
                {p.link ? (
                  <span class="ref-ext" aria-hidden="true">↗</span>
                ) : (
                  <span class="ref-tba" aria-hidden="true">(TBA)</span>
                )}
              </p>
            </div>
          </Tag>
        </li>
      );
    })
  }
</ol>

<style>
  .ref-list {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .ref-item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.9rem;
    align-items: start;
    padding: 0.9rem;
    margin-inline: -0.9rem;
    color: var(--text);
    transition: background 0.2s var(--ease);
  }

  .ref-code {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--accent);
    margin-top: 0.2rem;
    white-space: nowrap;
  }

  .ref-title {
    font-size: clamp(1.02rem, 1.7vw, 1.25rem);
    font-weight: 700;
    line-height: 1.28;
    letter-spacing: -0.015em;
    margin-bottom: 0.4rem;
    transition: color 0.2s var(--ease);
  }
  .ref-authors {
    font-size: 0.92rem;
    color: var(--text-soft);
    margin-bottom: 0.12rem;
  }
  .ref-authors :global(.me) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 2px;
    font-weight: 500;
  }
  .ref-venue {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem 0.6rem;
    font-size: 0.9rem;
    color: var(--text-soft);
    line-height: 1.5;
  }
  /* award-like highlight, e.g. Oral Presentation */
  .ref-award {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    margin-left: 0.15rem;
    padding: 0.15em 0.5em 0.22em;
    background: var(--accent);
    color: #fff;
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.01em;
  }

  /* external-link affordance: square box with an outward arrow */
  .ref-ext {
    flex: none;
    display: inline-grid;
    place-items: center;
    width: 1.4em;
    height: 1.4em;
    border: 1px solid var(--border);
    color: var(--text-soft);
    font-size: 0.85rem;
    transition: background 0.2s var(--ease), color 0.2s var(--ease),
      border-color 0.2s var(--ease);
  }
  .ref-tba {
    flex: none;
    font-size: 0.78rem;
    color: var(--text-soft);
    opacity: 0;
    transition: opacity 0.2s var(--ease);
  }

  /* translucent orange film on hover (like the image overlay) */
  a.ref-item:hover {
    background: color-mix(in srgb, var(--accent) 12%, transparent);
  }
  a.ref-item:hover .ref-title {
    color: var(--accent);
  }
  a.ref-item:hover .ref-ext {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }

  /* link-less rows: not clickable — reveal "(TBA)" on hover */
  div.ref-item {
    cursor: default;
  }
  div.ref-item:hover {
    background: color-mix(in srgb, var(--text) 4%, transparent);
  }
  div.ref-item:hover .ref-tba {
    opacity: 1;
  }
</style>
