---
interface Props {
  href: string;
  title: string;
  category: string;
  year: string;
  image: string;
  badge?: string;
  axis?: string;
  showCategory?: boolean;
}
const { href, title, category, year, image, badge, axis, showCategory = true } =
  Astro.props;
---

<a class="card" href={href}>
  <div class="card-media">
    <img src={image} alt={title} loading="lazy" />
  </div>
  <div class="card-info">
    <div class="card-row">
      <h3 class="card-title">{title}</h3>
      <span class="card-year mono">{badge ?? year}</span>
    </div>
    <div class="card-tags">
      {showCategory && <span class="card-kind mono">{category}</span>}
      {axis && <span class="card-axis">{axis}</span>}
    </div>
  </div>
</a>

<style>
  .card {
    display: block;
  }
  .card-media {
    position: relative;
    aspect-ratio: 6 / 5;
    overflow: hidden;
    background: var(--hover);
  }
  .card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }
  /* orange highlight wash on hover (à la US BY NIGHT) */
  .card-media::after {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--accent);
    mix-blend-mode: multiply;
    opacity: 0;
    transition: opacity 0.25s var(--ease);
  }
  .card:hover .card-media::after {
    opacity: 0.6;
  }

  .card-info {
    padding-top: 0.8rem;
  }
  .card-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }
  .card-title {
    font-size: 0.96rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.01em;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: color 0.2s var(--ease);
  }
  .card:hover .card-title,
  .card:hover .card-year {
    color: var(--accent);
  }
  .card-year {
    flex: none;
    font-size: 0.72rem;
    color: var(--text-soft);
    white-space: nowrap;
    transition: color 0.2s var(--ease);
  }
  .card-tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.55rem;
  }
  .card-kind {
    display: inline-block;
    background: var(--accent);
    color: #fff;
    font-size: 0.62rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    line-height: 1;
    padding: 0.32em 0.52em 0.38em;
  }
  /* research-axis tag (hybrid classification) */
  .card-axis {
    font-size: 0.72rem;
    font-style: italic;
    color: var(--accent);
  }
</style>
