---
import profile from "../data/profile.json";

const links = [
  { href: "/works", label: "Works" },
  { href: "/publications", label: "Publications" },
  { href: "/awards", label: "Awards" },
];
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header class="nav">
  <div class="wrap nav-inner">
    <a class="brand" href="/">
      <svg class="brand-logo" viewBox="0 0 135 107" aria-hidden="true">
        <path
          d="M62.5 61L8 106.5L29.5 58.5L-3.14722e-06 34.5L29.5 27L25 -1.09278e-06L73 15.5L106 3.5L85.5 30.5L135 32.5L81.5 53L106 90.5L62.5 61Z"
          fill="currentColor"
        ></path>
      </svg>
      <span>Yeji Park</span>
    </a>

    <nav class="nav-links" aria-label="Primary">
      {
        links.map((l) => {
          const base = l.href.replace(/\/$/, "") || "/";
          const active = path.startsWith(base);
          return (
            <a href={l.href} class:list={["nlink", { active }]}>
              {l.label}
            </a>
          );
        })
      }
      <a class="nlink" href={profile.cv} target="_blank" rel="noopener">CV ↗</a>
      <button id="theme-toggle" class="theme-btn" type="button" aria-label="Toggle color theme">
        <span class="t-light">◐</span><span class="t-dark">◑</span>
      </button>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 90%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.4rem 1.5rem;
    min-height: 54px;
    padding-block: 0.5rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 700;
    font-size: 1.1rem;
    letter-spacing: -0.02em;
  }
  .brand-logo {
    width: 22px;
    height: 18px;
    color: var(--accent);
    transform: rotate(72deg);
    transition: transform 0.4s var(--ease);
  }
  .brand:hover .brand-logo {
    transform: rotate(144deg) scale(1.08);
  }
  .nav-links {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.4rem;
  }
  .nlink {
    font-size: 0.92rem;
    font-weight: 400;
    letter-spacing: 0;
    color: var(--text-soft);
    transition: color 0.18s var(--ease);
  }
  .nlink:hover,
  .nlink.active {
    color: var(--accent);
  }

  .theme-btn {
    font-family: inherit;
    font-size: 0.95rem;
    background: none;
    border: 0;
    color: var(--text-soft);
    cursor: pointer;
    line-height: 1;
    padding: 0;
    transition: color 0.18s var(--ease);
  }
  .theme-btn:hover {
    color: var(--accent);
  }
  .t-dark {
    display: none;
  }
  :global([data-theme="dark"]) .t-light {
    display: none;
  }
  :global([data-theme="dark"]) .t-dark {
    display: inline;
  }

  @media (max-width: 560px) {
    .nav-links {
      gap: 0.9rem;
    }
    .nlink {
      font-size: 0.85rem;
    }
  }
</style>

<script>
  document.getElementById("theme-toggle")?.addEventListener("click", () => {
    const root = document.documentElement;
    const next = root.getAttribute("data-theme") === "dark" ? "light" : "dark";
    root.setAttribute("data-theme", next);
    try {
      localStorage.setItem("theme", next);
    } catch (e) {}
  });
</script>
